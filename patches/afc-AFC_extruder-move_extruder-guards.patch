+
         toolhead: ToolHead = self.printer.lookup_object("toolhead")
         stepper = self.toolhead_extruder.extruder_stepper.stepper
         toolhead.flush_step_generation()
         stepper.set_trapq(self.prev_trapq)
         stepper.set_stepper_kinematics(self.prev_sk)
+
+        # `move_extruder` zeroed this stepper to run the move in its own coordinate space,
+        # so it is now sitting at the move distance while the extruder still believes it is
