+                "asynchronously.\nSelect a different tool, or extrude with the printer idle."
+            )
+            return
+
+        # Being idle is not the same as being unfed. `SYNC_EXTRUDER_MOTION EXTRUDER=extruder2
+        # MOTION_QUEUE=extruder` binds our stepper to *another* extruder's trapq (klipper
+        # `ExtruderStepper.sync_to_extruder` -> `set_trapq(extruder.get_trapq())`), which is
+        # what IDEX copy/mirror printing does for the secondary toolheads. That queue's owner
+        # keeps appending moves while we are not the active extruder, so the check above lets
+        # it through -- and stealing the stepper then collides with the owner's step
+        # generation, which klipper reports as "Error in syncemitter '<name>'".
+        #
+        # Syncing to our *own* queue is the ordinary parked state (a normal print syncs every
+        # extruder to itself) and is the legitimate case this async path exists for, so it
+        # stays allowed; the active-extruder check above is what covers it when it is in use.
+        motion_queue = self.toolhead_extruder.extruder_stepper.motion_queue
+        if motion_queue is not None and motion_queue != self.th_extruder_name:
+            self.logger.error(
+                f"{self.th_extruder_name} is synced to '{motion_queue}', refusing to move it "
+                "asynchronously.\nUnsync it first (SYNC_EXTRUDER_MOTION "
+                f"EXTRUDER={self.th_extruder_name} MOTION_QUEUE=) or leave copy/mirror mode."
+            )
+            return
+
+        self.load_active = True
         stepper = self.toolhead_extruder.extruder_stepper.stepper
 
+        # Step generation must be quiesced before rebinding a stepper's kinematics, trapq or
